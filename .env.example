GO_GUESTBOOK_HTTP_PORT=8084

# App environment: development enables /admin/tools (arbitrary SQL).
# Docker Compose defaults to production when unset; set development only for local tooling.
GO_GUESTBOOK_ENVIRONMENT=development

# Gin mode: release (default) or debug.
GIN_MODE=release

# Random string, at least 32 characters (used to sign session cookies).
GO_GUESTBOOK_SESSION_SECRET=change-me-session-secret-min-32-chars
# Set to 1 or true when serving over HTTPS.
GO_GUESTBOOK_SESSION_SECURE=0

GO_GUESTBOOK_DATABASE_HOST=shared-postgres
GO_GUESTBOOK_DATABASE_PORT=5432
GO_GUESTBOOK_DATABASE_NAME=goguestbook
GO_GUESTBOOK_DATABASE_USER=goguestbook
GO_GUESTBOOK_DATABASE_PASSWORD=change-me-goguestbook

# Enable the test REST API for Playwright and integration tests.
GO_GUESTBOOK_TEST_API_ENABLED=0

# Cap total guestbook messages (default 10000). Set ENABLED=0 to disable the check.
GO_GUESTBOOK_MAX_MESSAGES_ENABLED=1
GO_GUESTBOOK_MAX_MESSAGES=10000

# Login POST rate limit (per client IP). Set ENABLED=0 to disable.
GO_GUESTBOOK_LOGIN_RATE_LIMIT_ENABLED=1
GO_GUESTBOOK_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
GO_GUESTBOOK_LOGIN_RATE_LIMIT_WINDOW=1m

# Public message POST rate limit (per client IP). Set ENABLED=0 to disable.
GO_GUESTBOOK_MESSAGE_RATE_LIMIT_ENABLED=1
GO_GUESTBOOK_MESSAGE_RATE_LIMIT_MAX_ATTEMPTS=10
GO_GUESTBOOK_MESSAGE_RATE_LIMIT_WINDOW=1m
